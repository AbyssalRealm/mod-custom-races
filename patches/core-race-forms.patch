+    void KeepCreatedLooks(CharacterCreateInfo const* createInfo, CreatedLooks const& looks)
+    {
+        std::lock_guard<std::mutex> guard(sCreatedExtraLock);
+        if (looks.hasLook || looks.hasShape)
+            sCreatedLooks[createInfo] = looks;
+        else
+            sCreatedLooks.erase(createInfo);       // an earlier request at the same address
+    }
+
+    CreatedLooks TakeCreatedLooks(CharacterCreateInfo const* createInfo)
+    {
+        std::lock_guard<std::mutex> guard(sCreatedExtraLock);
+        CreatedLooks looks;
+        auto found = sCreatedLooks.find(createInfo);
+        if (found != sCreatedLooks.end())
